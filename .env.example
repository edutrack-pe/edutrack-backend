# Copia este archivo como .env y completa los valores. NUNCA subas .env a Git (Ley 29733).

# --- Base de datos ---
# Local sin Docker (rapido):       sqlite:///./edutrack.db
# Docker Compose (desarrollo):     mysql+pymysql://edutrack:${MYSQL_PASSWORD}@mysql:3306/edutrack
# Produccion (AWS RDS):            mysql+pymysql://USUARIO:CLAVE@<endpoint-rds>.rds.amazonaws.com:3306/edutrack
DATABASE_URL=sqlite:///./edutrack.db
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
# Puerto de MySQL en tu PC (3307 para no chocar con un MySQL instalado)
MYSQL_HOST_PORT=3307

# --- Seguridad (JWT) ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto
JWT_EXPIRES_MINUTES=120

# --- Servicios ---
ML_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173

# --- Datos demo (scripts/seed.py) ---
SEED_DEFAULT_PASSWORD=cambia-esta-clave-demo

# --- Produccion ---
DOMINIO=edutrack.pe
